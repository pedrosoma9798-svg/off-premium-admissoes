# ─────────────────────────────────────────────────────────────
# Copie este arquivo para .env.local e preencha com os dados do
# seu projeto (Supabase → Project Settings → API).
# ─────────────────────────────────────────────────────────────

# URL do projeto. Ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...).
# Pode ir para o navegador: quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA: "service_role" (legada) ou "secret" (sb_secret_...).
# Usada SOMENTE no servidor para criar/editar contas de usuário.
# Ela ignora o RLS: nunca coloque prefixo NEXT_PUBLIC_, nunca commite.
SUPABASE_SERVICE_ROLE_KEY=
